rules_version = '2';

// Mağaza Performans Takip (v2) — Firestore güvenlik kuralları
//
// Bu proje yalnızca v2'ye aittir; v1 (rapor.html) ayrı bir Firebase
// projesinde çalışır. Burada anonim giriş kullanılmaz, herkes kullanıcı
// adı ve şifresiyle girer.
//
// Kurucuyu belirleyen tek yer aşağıdaki e-posta listesidir.

service cloud.firestore {
  match /databases/{database}/documents {

    function girisli(){ return request.auth != null; }
    function eposta(){ return request.auth.token.email; }
    function kullaniciVar(){
      return girisli() && exists(/databases/$(database)/documents/mc2_kullanicilar/$(request.auth.uid));
    }
    function kullanici(){
      return get(/databases/$(database)/documents/mc2_kullanicilar/$(request.auth.uid)).data;
    }
    function kurucuMu(){
      return girisli() && (
        eposta() in ['osmanonurmrt@gmail.com']
        || (kullaniciVar() && kullanici().rol == 'kurucu')
      );
    }
    function bolgeMu(){ return kullaniciVar() && kullanici().rol == 'bolge'; }
    function v2Uye(){ return kurucuMu() || kullaniciVar(); }
    function genisYetki(){ return kurucuMu() || bolgeMu(); }
    function kendiMagazam(magaza){ return kullaniciVar() && kullanici().magazaKey == magaza; }

    // Kullanıcı ↔ mağaza eşlemesi
    match /mc2_kullanicilar/{uid} {
      // Kendi kaydını okumak v2Uye()'ye bağlanamaz: v2Uye() zaten bu kaydın
      // varlığına bakıyor, kayıtsız hesap "yok" cevabı yerine hata alırdı.
      allow read: if girisli() && request.auth.uid == uid;
      allow read: if genisYetki();
      // Kurucu kendi kaydını ilk girişte oluşturur; gerisini yalnızca kurucu yazar.
      allow write: if kurucuMu();
    }

    // Ortak veriler: profiller, kategoriler, duyurular, talepler, ayarlar
    match /mc2_ortak/{belge} {
      allow read: if v2Uye();
      // Talepleri mağaza müdürü de yazabilmeli; duyuru ve ayarlar bölge/kurucu işi.
      allow write: if genisYetki() || (belge == 'talepler' && kullaniciVar());
    }

    // Mağaza verileri
    match /mc2_magazalar/{magaza} {
      allow read: if v2Uye();
      allow write: if genisYetki();

      match /{belge=**} {
        allow read: if genisYetki() || kendiMagazam(magaza);
        // Bölge müdürü hedef yazabilsin diye yazma yetkisi geniş tutuldu.
        allow write: if genisYetki() || kendiMagazam(magaza);
      }
    }

    // Başka hiçbir yol açık değil.
  }
}
